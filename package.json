{
  "name": "midi-arcade",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "python -m http.server 4173",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "benchmark:generation": "node scripts/benchmark-generation.mjs",
    "quality": "npm test && npm run build && node scripts/check-build-quality.js",
    "android:sync": "npm run build && cap sync android",
    "android:verify": "npm run android:sync && cd android && .\\gradlew.bat :app:lintRelease :app:testReleaseUnitTest",
    "android:bundle": "npm run android:sync && cd android && .\\gradlew.bat :app:bundleRelease"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0"
  }
}
